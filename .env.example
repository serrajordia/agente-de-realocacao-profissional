# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o .env de verdade (já está no .gitignore).

# Adzuna (developer.adzuna.com) — cadastro gratuito
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gmail SMTP — gere uma "senha de app" em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=juka42@gmail.com
SMTP_PASSWORD=
EMAIL_TO=juka42@gmail.com

# Opcional: melhora a classificação das vagas e a geração do resumo/CV
# usando Claude. Sem isso, o agente usa uma heurística por palavras-chave.
ANTHROPIC_API_KEY=

# Google Drive — ver SETUP.md. Caminhos default já apontam para
# credentials.json / token.json na raiz do projeto.
# GOOGLE_DRIVE_CREDENTIALS_FILE=
# GOOGLE_DRIVE_TOKEN_FILE=
# GOOGLE_DRIVE_FOLDER_ID=1jzbBVlf7bao2WYPcstp5ahVkrdiSIvDv
